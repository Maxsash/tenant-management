{
  "name": "Expenses — Shrivastava Hub",
  "short_name": "Expenses",
  "description": "Household rhythms, spending insights, and expense logging",
  "start_url": "/expense",
  "scope": "/expense",
  "display": "standalone",
  "background_color": "#fbf5e9",
  "theme_color": "#cfe8f6",
  "icons": [
    {
      "src": "/manifest-icon/expense",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Scan a slip",
      "short_name": "Scan slip",
      "description": "Photograph a handwritten slip and check the lines it reads",
      "url": "/expense/log?scan=1",
      "icons": [
        {
          "src": "/manifest-icon/expense",
          "sizes": "512x512",
          "type": "image/png"
        }
      ]
    }
  ]
}
